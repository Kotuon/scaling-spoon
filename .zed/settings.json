{
  "lsp": {
    "roslyn": {
      "initialization_options": {
        "enableFormatting": true,
        "documentFormatting": true
      },
      "settings": {
        "csharp": {
          "format": {
            "enable": true
          }
        }
      }
    }
  }
}
